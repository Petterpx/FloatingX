<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.petterp.floatingx.demo.DemoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloatingX">

        <activity
            android:name="com.petterp.floatingx.demo.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.petterp.floatingx.demo.pages.AppHostActivity" />
        <activity android:name="com.petterp.floatingx.demo.pages.SecondActivity" />
        <activity android:name="com.petterp.floatingx.demo.pages.BlackActivity" />
        <activity
            android:name="com.petterp.floatingx.demo.pages.ImmersedActivity"
            android:theme="@style/Theme.FloatingX.Immersed" />
        <!-- 后续 Task 追加页面；一律不配 configChanges（spec §10：旋转走 recreate） -->
    </application>
</manifest>
